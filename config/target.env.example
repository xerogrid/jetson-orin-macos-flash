# COPY to .local/jetson-vm/target.env and edit AFTER RAM-only inspection.
# This workflow only supports the Xavier NX SD developer module (P3668-0000).
BOARDID=3668
BOARDSKU=0000
FAB=REPLACE_FROM_DEVICE_TREE
BOARDREV=REPLACE_FROM_DEVICE_TREE
EXPECTED_NVME_SERIAL=REPLACE_FROM_LSBLK
EXT_NUM_SECTORS=REPLACE_FROM_BLOCKDEV_GETSZ
APP_SIZE_GIB=32
